#!/bin/bash -l
# ==========================================================
# MPI Parallel Beam Property Extraction (600+ positions)
# Using Intel MPI on UB HPC general-compute nodes
# ==========================================================

# --- SLURM Resource Requests ---
# We need 30 MPI tasks to process 600 positions (600 / 30 = 20 positions per task)
#SBATCH --ntasks=30

# Each MPI task will use PyTorch with 8 threads, matching the script's configuration.
#SBATCH --cpus-per-task=8

# Memory: Requesting 4GB per CPU core.
# Total per task: 8 cpus * 4GB/cpu = 32GB.
#SBATCH --mem-per-cpu=4G

# Using a constraint for homogeneous nodes can improve performance/stability.
#SBATCH --constraint="CASCADE-LAKE-IB"

#   Job Name
#SBATCH --job-name="extract-beams-mpi"

#   Email Notifications
#SBATCH --mail-user=myemailaddress@institution.edu
#SBATCH --mail-type=FAIL,END

#   Cluster, Partition, QOS
#SBATCH --partition=general-compute
#SBATCH --qos=nih
#SBATCH --cluster=ub-hpc

# --- Environment Setup ---
echo "--- Job Information ---"
echo "Job ID: $SLURM_JOB_ID"
echo "Job Name: $SLURM_JOB_NAME"
echo "Node List: $SLURM_JOB_NODELIST"
echo "Number of Nodes: $SLURM_JOB_NUM_NODES"
echo "Number of MPI Tasks: $SLURM_NTASKS"
echo "CPUs per Task: $SLURM_CPUS_PER_TASK"

echo "--- Loading Modules ---"
module purge
module load intel gcccore/11.2.0 hdf5/1.14.1
echo "--- Modules After Loading ---"
module list

# Activate your virtual environment
echo "--- Activating Virtual Environment ---"
source ~/myenv/bin/activate
echo "Python executable: $(which python)"

# --- Intel MPI Configuration ---
echo "--- Setting Intel MPI Environment Variables ---"
export I_MPI_DEBUG=4
export I_MPI_PMI_LIBRARY=/opt/software/slurm/lib64/libpmi2.so
env | grep I_MPI

# --- Execution ---
# Navigate to the directory containing your script and where you want the 'output' directory to be created.
cd /vscratch/grp-rutaoyao/Harsh/ALL_CONFIGS/random_pattern_rots_trans/ppdf-analysis/beam-analysis
echo "Current directory: $(pwd)"

echo "--- Running MPI Python Script for Beam Property Extraction ---"
# Call the NEW MPI-enabled Python script and pass the two required arguments.
# Use backslashes (\) to make the long command more readable.
srun --mpi=pmi2 python extract_beams_properties_mpi.py \
    /vscratch/grp-rutaoyao/Harsh/ALL_CONFIGS/random_pattern_rots_trans/scanner_layouts/scanner_layouts_508640ff8dc59f67dd884fdbc89ee122.tensor \
    /vscratch/grp-rutaoyao/Harsh/ALL_CONFIGS/random_pattern_rots_trans/scanner_layouts_508640ff8dc59f67dd884fdbc89ee122

echo "--- Job Finished ---"